# Frontend Environment Variables
# Copy this file to .env and adjust values for your setup

# Optional: override the API base URL.
# In development, leave this empty/commented so Vite's proxy (vite.config.js)
# forwards /api and /uploads to localhost:4000 automatically.
# In production, set this to your deployed backend domain.
VITE_API_BASE=https:/watch-project-6.onrender.com
